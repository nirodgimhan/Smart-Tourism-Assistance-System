{
  "name": "gocelone-backend",
  "version": "1.0.0",
  "description": "Gocelone - AI Powered Smart Tourism Assistance System Backend",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/seed.ts",
    "seed:admin": "tsx src/seed/seedAdmin.ts"
  },
  "keywords": [
    "gocelone",
    "smart-tourism",
    "react",
    "mongodb",
    "express",
    "typescript",
    "artificial-intelligence",
    "travel-planner",
    "tour-guide",
    "weather",
    "hotel-finder",
    "tourist-safety"
  ],
  "author": "Gocelone Research Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
